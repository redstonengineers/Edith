# Nunca pongas secretos en variables VITE_*: se incluyen en el bundle del navegador.
# Modo de datos: "mock" (localStorage, sin backend) | "api" (REST real)
VITE_DATA_MODE=mock
VITE_API_URL=http://localhost:4000/api
# Las claves de IA (ANTHROPIC_API_KEY, etc.) viven SOLO en el backend.
# Proveedor de IA: "mock" (local) | "http" (POST {VITE_API_URL}/ai/chat; la clave del modelo vive en el servidor)
VITE_AI_PROVIDER=mock

# ───── Servidor (npm run server) ─────  (estas variables NO llevan prefijo VITE_: nunca llegan al navegador)
# PORT=4000
# HOST=127.0.0.1
# DB_PATH=./data/academy.db
# NODE_ENV=production            # activa cookie Secure (requiere HTTPS)
# SESSION_HOURS=12
# TRUST_PROXY=1                  # solo detrás de un proxy inverso de confianza (IP real para limitar intentos)
# BOOTSTRAP_ADMIN_EMAIL=owner@tudominio.com   # crea el Super Admin si la base está vacía
# BOOTSTRAP_ADMIN_PASSWORD=...                # usa un secreto largo; cámbialo tras el primer acceso
# SEED_DEMO=1                    # SOLO desarrollo: carga las academias de demostración (contraseña "demo")
# RESEED=1                       # SOLO desarrollo: borra la base y vuelve a sembrar
